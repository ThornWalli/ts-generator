{
  "compilerOptions": {
    "esModuleInterop": true,
    "moduleResolution": "node",
    "module": "ESNext",
    "target": "ESNext",
    "outDir": "./dist",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "rxjs/*": [
        "./node_modules/rxjs/*"
      ]
    }
  },
  "include": [
    "build/**/*.ts",
    "src/**/*.ts",
    "./node_modules/rxjs/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}

