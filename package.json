    "dotenv": "^16.4.7",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.3",
    "globals": "15.14.0",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "prettier": "3.4.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.22.0",
